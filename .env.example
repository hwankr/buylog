# 이 파일을 .env로 복사하고 필요한 값을 입력하세요.
# .env는 Git에서 제외되지만 Flutter 앱의 asset으로 빌드에 포함됩니다.
# 배포용 비밀 API 키는 서버에서 관리하세요. Supabase service_role 키는 넣지 마세요.

# 필수: 앱 시작 및 데이터 연결 (클라이언트용 anon key 사용)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# 선택: Gemini 이미지 인식 및 OCR 결과 파싱
GEMINI_API_KEY=

# 선택: Google Cloud Vision OCR
GOOGLE_CLOUD_VISION_API_KEY=

# 선택: 네이버 쇼핑 가격 비교 직접 호출 (서버 프록시 미사용/실패 시)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 선택: 가격 비교 상품 분석 보조
OPENAI_API_KEY=
